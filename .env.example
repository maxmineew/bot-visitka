# Токен бота из @BotFather
BOT_TOKEN=

# Необязательно: HTTP-прокси, если хостинг не достаёт до api.telegram.org (http://user:pass@host:port)
BOT_PROXY=

# Ваш Telegram numeric ID (необязательно, зарезервировано под будущие уведомления администратору)
ADMIN_ID=

# Контакты, используемые в кнопках бота
CONTACT_USERNAME=
CONTACT_EMAIL=
GITHUB_URL=

# Яндекс.Диск — выгрузка Excel-отчёта по визитам бота (analytics/export.py).
# Токен получить на https://yandex.ru/dev/disk/poligon/ (кнопка "Получить OAuth-токен",
# нужен доступ на чтение и запись в Диск). Если не заполнить — отчёт будет
# собираться только локально (analytics/visits.db), без выгрузки.
YANDEX_DISK_TOKEN=
YANDEX_DISK_PATH=/Signea/Бот-визитка/visits.xlsx
